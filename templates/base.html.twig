<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Gestion de Tâches{% endblock %}</title>
        {# Tailwind Play CDN #}
        <script src="https://cdn.tailwindcss.com"></script>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
        <style>
            body { font-family: 'Inter', sans-serif; }
        </style>
    </head>
    <body class="bg-[#EEF4FF]">
        {% if app.user %}
            <div class="flex h-screen overflow-hidden bg-white">
                {# SIDEBAR #}
                <aside class="w-64 bg-[#F8F9FA] border-r border-gray-200 flex flex-col p-4">
                    <div class="px-3 mb-8">
                        <span class="font-bold text-xs uppercase tracking-widest text-gray-400">Dossiers</span>
                    </div>
                    
                    <nav class="space-y-1">
                        <a href="{{ path('app_task_index') }}" class="flex items-center justify-between px-3 py-2 text-sm font-medium rounded-lg bg-[#080915] text-white">
                            <div class="flex items-center">
                                <i class="bi bi-list-task mr-3"></i> Toutes les tâches
                            </div>
                        </a>
                        
                        <div class="pt-4 px-3 mb-2">
                            <span class="font-bold text-xs uppercase tracking-widest text-gray-400">Dossiers</span>
                        </div>

                        <a href="{{ path('app_folder_new') }}" class="flex items-center justify-between px-3 py-2 text-sm font-medium text-black rounded-lg hover:bg-gray-800 hover:text-white">
                            <div class="flex items-center"> Créer un nouveau dossier
                            </div>
                            <span class="text-xs font-semibold">+</span>
                        </a>

                        {% for folder in folders %}
                            <a href="{{ path('app_folder_show', {id: folder.id}) }}" class="flex items-center justify-between px-3 py-2 text-sm font-medium text-gray-600 rounded-lg hover:bg-gray-100">
                                <div class="flex items-center">
                                    <span class="w-2 h-2 rounded-full bg-green-500 mr-3"></span>
                                    <i class="bi bi-folder2 mr-3"></i> {{folder.name}}
                                </div>
                                <span class="text-xs font-semibold">1</span>
                            </a>
                        {% else %}
                            <h3>Ajouter un nouveau dossier !</h3>
                        {% endfor %}
                    </nav>

                    <div class="mt-auto border-t pt-4">
                        <a href="{{ path('app_logout') }}" class="flex items-center px-3 py-2 text-sm font-medium text-red-500 hover:bg-red-50">
                            <i class="bi bi-box-arrow-right mr-3"></i> Déconnexion
                        </a>
                    </div>
                </aside>

                {# MAIN CONTENT #}
                <main class="flex-1 overflow-y-auto bg-white">
                    {% block body %}{% endblock %}
                </main>
            </div>
        {% else %}
            {# AUTH WRAPPER #}
            <div class="min-h-screen flex items-center justify-center p-4">
                {% block auth_content %}{% endblock %}
            </div>
        {% endif %}
    </body>
</html>