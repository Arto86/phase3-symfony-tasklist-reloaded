{% extends 'base.html.twig' %}

{% block title %}{{ folder.name }}{% endblock %}

{% block body %}
<div class="p-10 max-w-4xl mx-auto">
    {# Header du dossier #}
    <div class="flex justify-between items-center mb-10">
        <div>
            <div class="flex items-center gap-3 mb-1">
                <span class="w-3 h-3 rounded-full bg-blue-500"></span> {# Point de couleur dynamique possible ici #}
                <h1 class="text-3xl font-bold text-gray-900">{{ folder.name }}</h1>
            </div>
            <p class="text-gray-400 text-sm">{{ folder.tasks|length }} tâches dans ce dossier</p>
        </div>
        
        <div class="flex gap-2">
            <a href="{{ path('app_folder_edit', {id: folder.id}) }}" class="px-4 py-2 text-sm font-medium border rounded-lg hover:bg-gray-50">
                <i class="bi bi-pencil mr-2"></i>Modifier
            </a>
            <a href="{{ path('app_task_new') }}" class="px-4 py-2 text-sm font-bold bg-[#080915] text-white rounded-lg hover:bg-black">
                <i class="bi bi-plus-lg mr-2"></i> Ajouter une tâche
            </a>
        </div>
    </div>

    {# Liste des tâches du dossier #}
    <div class="space-y-3">
        {% for task in folder.tasks %}
            <div class="group flex items-center p-4 bg-white border border-gray-100 rounded-2xl shadow-sm hover:border-gray-200 transition-all">
                <div class="flex-1">
                    <span class="font-bold text-gray-900 {% if task.status.value == 'terminée' %}line-through text-gray-400{% endif %}">
                        {{ task.title }}
                    </span>
                    <div class="flex items-center gap-2 mt-1">
                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-gray-100 text-gray-500 font-bold uppercase">
                            {{ task.priority.name|default('Normale') }}
                        </span>
                    </div>
                </div>
                
                <a href="{{ path('app_task_edit', {id: task.id}) }}" class="text-gray-300 hover:text-gray-900">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        {% else %}
            <div class="text-center py-16 bg-gray-50 rounded-3xl border-2 border-dashed border-gray-200">
                <p class="text-gray-400 italic">Ce dossier est vide.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}