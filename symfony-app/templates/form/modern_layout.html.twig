{% use 'form_div_layout.html.twig' %}

{% block form_row %}
    <div class="mb-8">
        {{ form_label(form, null, {'label_attr': {'class': 'block text-[10px] font-black uppercase tracking-widest mb-2'}}) }}
        {{ form_widget(form, {'attr': {'class': 'w-full border-b-2 border-black py-3 px-0 focus:outline-none focus:border-gray-400 bg-transparent rounded-none transition-all'}}) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block button_widget %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' bg-black text-white px-8 py-4 uppercase text-xs font-bold tracking-widest border border-black hover:bg-white hover:text-black transition-all')|trim}) %}
    <button type="{{ type|default('button') }}" {{ block('button_attributes') }}>{{ label|trans }}</button>
{% endblock %}