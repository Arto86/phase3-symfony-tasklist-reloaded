{% extends 'base.html.twig' %}

{% block auth_content %}
<div class="bg-white rounded-[20px] p-8 shadow-sm w-full max-w-[440px]">
    <div class="mb-6">
        <h1 class="text-xl font-bold text-gray-900">Gestion de Tâches</h1>
        <p class="text-gray-400 text-sm">Organisez votre journée efficacement</p>
    </div>

    {# Tab Switcher #}
    <div class="flex p-1 bg-gray-100 rounded-full mb-8">
        <a href="{{ path('app_login') }}" class="flex-1 bg-white shadow-sm rounded-full py-2 text-sm font-bold text-center text-gray-900">Connexion</a>
        <a href="{{ path('app_register') }}" class="flex-1 py-2 text-sm font-medium text-center text-gray-400">Inscription</a>
    </div>

    <form method="post">
        <div class="mb-4">
            <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Email</label>
            <input type="email" name="_username" class="w-full bg-gray-50 border-none rounded-xl p-3 text-sm focus:ring-2 focus:ring-gray-200 outline-none" placeholder="votre@email.com" required>
        </div>
        
        <div class="mb-8">
            <label class="block text-xs font-bold text-gray-700 uppercase mb-2">Mot de passe</label>
            <input type="password" name="_password" class="w-full bg-gray-50 border-none rounded-xl p-3 text-sm focus:ring-2 focus:ring-gray-200 outline-none" placeholder="********" required>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="w-full bg-[#080915] text-white font-bold py-3 rounded-xl hover:bg-black transition-colors text-sm">
            Se connecter
        </button>
    </form>
</div>
{% endblock %}